# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_DB=hcai
POSTGRES_USER=hcai
POSTGRES_PASSWORD=hcai
POSTGRES_PORT=55432
DATABASE_URL=postgres://hcai:hcai@localhost:55432/hcai

# ClickHouse
CLICKHOUSE_DB=hcai
CLICKHOUSE_USER=hcai
CLICKHOUSE_PASSWORD=hcai
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=http://localhost:8123

# Gateway
BASE_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Every model OpenRouter lists is available; there is no allowlist.
# Comma-separated ids to highlight on the landing page and in quickstarts.
FEATURED_MODELS=openai/gpt-4o-mini
ENFORCE_IDV=false
# Output tokens reserved when neither the caller nor the model declares a
# maximum. See docs/architecture/storage-and-billing.md.
RESERVATION_FALLBACK_OUTPUT_TOKENS=8192

# Hack Club sign-in (dashboard). Sign-in routes are disabled when unset.
HACK_CLUB_CLIENT_ID=
HACK_CLUB_CLIENT_SECRET=
# Incoming Slack webhook notified when a flagged-country address signs in.
SLACK_GEOBLOCK_WEBHOOK_URL=

# Sentry error reporting (optional).
SENTRY_DSN=

# Gated providers enabled for every user, e.g. enable_exa,enable_ocr,enable_replicate,enable_jev
ENABLED_FEATURES=

# Additional providers
OPENAI_MODERATION_API_URL=https://api.openai.com/v1/moderations
OPENAI_MODERATION_API_KEY=
MISTRAL_API_KEY=
# Mistral OCR reports no cost; billed per page at this USD price.
MISTRAL_OCR_PAGE_PRICE_USD=0.001
EXA_API_KEY=
REPLICATE_API_KEY=
# Browser session used by GET /up to report Replicate's unused credit.
REPLICATE_USERNAME=
REPLICATE_SESSION_ID=
TYPESAFE_API_KEY=
ALLOWED_IMAGE_MODELS=
