# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_DB=hcai
POSTGRES_USER=hcai
POSTGRES_PASSWORD=hcai
POSTGRES_PORT=55432
DATABASE_URL=postgres://hcai:hcai@localhost:55432/hcai

# ClickHouse. In production all three of CLICKHOUSE_URL, CLICKHOUSE_USER and
# CLICKHOUSE_PASSWORD are required; the values below are the local compose
# defaults and only apply when NODE_ENV is development or test.
# CLICKHOUSE_DB names the database compose creates and the app and
# migrations use (default hcai); queries name tables unqualified.
CLICKHOUSE_DB=hcai
CLICKHOUSE_USER=hcai
CLICKHOUSE_PASSWORD=hcai
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=http://localhost:8123

# Gateway
BASE_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Every model OpenRouter lists is available; there is no allowlist.
# Comma-separated ids to highlight on the landing page and in quickstarts.
FEATURED_MODELS=openai/gpt-4o-mini
ENFORCE_IDV=false
# Output tokens reserved when neither the caller nor the model declares a
# maximum. See docs/architecture/storage-and-billing.md.
RESERVATION_FALLBACK_OUTPUT_TOKENS=8192
# Largest accepted request body in bytes (default 20 MiB). The SvelteKit
# build also honours the adapter's BODY_SIZE_LIMIT (e.g. 20M); keep them equal.
MAX_REQUEST_BODY_BYTES=20971520
# The SvelteKit build reads BODY_SIZE_LIMIT (adapter-bun) instead; keep equal.
# BODY_SIZE_LIMIT=20M

# Hack Club sign-in (dashboard). Required.
HACK_CLUB_CLIENT_ID=
HACK_CLUB_CLIENT_SECRET=
# Sentry error reporting (optional).
SENTRY_DSN=

# Minimum log level: trace, debug, info (default), warn, error, fatal.
# Read by src/log.ts at import, before loadEnv().
LOG_LEVEL=

# Providers. Every key is required: the server refuses to start without one.
OPENAI_MODERATION_API_URL=https://api.openai.com/v1/moderations
OPENAI_MODERATION_API_KEY=
MISTRAL_API_KEY=
# Mistral OCR reports no cost; billed per page at this USD price.
MISTRAL_OCR_PAGE_PRICE_USD=0.001
# Per-page price when a request asks for document/bbox annotations (Mistral bills these higher)
MISTRAL_OCR_ANNOTATION_PAGE_PRICE_USD=0.003
EXA_API_KEY=
REPLICATE_API_KEY=
# Optional: browser session GET /up uses to report Replicate's unused credit.
REPLICATE_USERNAME=
REPLICATE_SESSION_ID=
TYPESAFE_API_KEY=
# Jev reports tokens but no cost; billed per million input tokens at this USD price.
TYPESAFE_INPUT_PRICE_PER_MILLION_USD=0.042
ALLOWED_IMAGE_MODELS=

# Test servers (README "Tests"). Defaults are the compose servers; each
# `bun test` run creates and drops its own databases on them.
# TEST_DATABASE_URL=postgres://hcai:hcai@localhost:55432/postgres
# TEST_CLICKHOUSE_URL=http://localhost:8123
# TEST_CLICKHOUSE_USER=hcai
# TEST_CLICKHOUSE_PASSWORD=hcai
