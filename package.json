{
  "name": "hcai-neo-elysia",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "dev": "bunx --bun vite dev --port 3000",
    "db:up": "docker compose up -d --wait && bun run db:migrate",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres clickhouse garage",
    "db:reset": "docker compose down --volumes",
    "db:migrate": "bun scripts/migrate.ts",
    "abuse:check": "bun scripts/abuse-check.ts",
    "build": "bunx --bun vite build",
    "start": "bun run db:migrate && bun ./build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "api": "bun run --watch src/index.ts",
    "dev:reset-db": "docker compose down --volumes && bun run db:up"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@sentry/bun": "^10.75.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "bits-ui": "^2.19.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dbmate": "^2.36.0",
    "elysia": "2.0.0-exp.64",
    "graphile-worker": "^0.18.0",
    "mode-watcher": "^1.1.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "remixicon-svelte": "^0.0.5",
    "shadcn-svelte": "^1.7.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0-next.2",
    "@sveltejs/kit": "^3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "bun-types": "1.4.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.1"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
