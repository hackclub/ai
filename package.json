{
  "name": "hcai-neo-elysia",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "dev": "bunx --bun vite dev --port 3000",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres clickhouse",
    "db:reset": "docker compose down --volumes",
    "db:check": "sh scripts/check-datastores.sh",
    "db:migrate": "bun scripts/migrate.ts",
    "test:integration": "bun scripts/test-integration.ts",
    "build": "vite build",
    "start": "bun ./build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "api": "bun run --watch src/index.ts",
    "dev:seed": "bun scripts/dev-seed.ts",
    "dev:reset-db": "docker compose down --volumes && docker compose up -d --wait"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@fontsource/maple-mono": "^5.3.0",
    "@sentry/bun": "^10.75.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/canvas-confetti": "^1.9.0",
    "bits-ui": "^2.16.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "elysia": "2.0.0-exp.64",
    "graphile-worker": "^0.18.0",
    "mode-watcher": "^1.1.0",
    "postgres": "^3.4.7",
    "remixicon-svelte": "^0.0.5",
    "shadcn-svelte": "^1.4.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0-next.2",
    "@sveltejs/kit": "^3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "bun-types": "latest",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.3.0"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
